---
import { COMMENTS, memberByHandle, avatarUrl, relativeTime } from "../lib/community";

interface Props {
  article: string;
}
const { article } = Astro.props;
const seed = COMMENTS.filter((c) => c.article === article);
const uid = "cd" + Math.random().toString(36).slice(2, 8);
const totalSeed = seed.reduce((n, c) => n + 1 + (c.replies?.length ?? 0), 0);
---

<section id={uid} class="mt-12" data-article={article}>
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white">💬 Community discussion</h2>
    <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-900/30 dark:text-amber-300" title="Sample data to showcase the discussion feature. Real, persistent comments use GitHub Discussions below.">
      ✨ Demo
    </span>
  </div>

  <!-- Add a comment (stored privately in your browser) -->
  <div class="mb-6 rounded-2xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-white/[0.03]">
    <div class="flex items-center gap-2">
      <input data-name placeholder="Your name (optional)" class="w-44 rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm outline-none focus:border-brand-500 dark:border-white/15" />
      <span class="text-xs text-gray-400">— posts save in your browser</span>
    </div>
    <textarea data-body rows="2" placeholder="Add your thoughts, a question, or a counter-argument…" class="mt-2 w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm outline-none focus:border-brand-500 dark:border-white/15"></textarea>
    <div class="mt-2 flex justify-end">
      <button data-post class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700">Post comment</button>
    </div>
  </div>

  <p class="mb-3 text-sm text-gray-500 dark:text-gray-400"><span data-count>{totalSeed}</span> comments</p>

  <div data-yours class="space-y-4"></div>

  <div class="space-y-4">
    {
      seed.map((c) => {
        const m = memberByHandle(c.handle);
        return (
          <div class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-white/[0.03]">
            <div class="flex items-start gap-3">
              <img src={avatarUrl(c.handle)} alt={m?.name} width="40" height="40" loading="lazy" class="h-10 w-10 shrink-0 rounded-full bg-gray-100 dark:bg-white/10" />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 text-sm">
                  <span class="font-semibold text-gray-900 dark:text-white">{m?.name ?? c.handle}</span>
                  <span class="text-gray-400">@{c.handle}</span>
                  {m && <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-900/30 dark:text-brand-300">{m.role}</span>}
                  <span class="text-xs text-gray-400">· {relativeTime(c.postedAt)}</span>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-gray-700 dark:text-gray-200">{c.body}</p>
                <button data-like class="mt-2 inline-flex items-center gap-1 rounded-lg border border-gray-200 px-2.5 py-1 text-xs font-semibold text-gray-600 transition hover:border-brand-400 hover:text-brand-600 dark:border-white/10 dark:text-gray-300">
                  <span>👍</span> <span data-likes>{c.likes}</span>
                </button>

                {c.replies && c.replies.length > 0 && (
                  <div class="mt-3 space-y-3 border-l-2 border-gray-100 pl-4 dark:border-white/10">
                    {c.replies.map((r) => {
                      const rm = memberByHandle(r.handle);
                      return (
                        <div class="flex items-start gap-2">
                          <img src={avatarUrl(r.handle)} alt={rm?.name} width="28" height="28" loading="lazy" class="h-7 w-7 shrink-0 rounded-full bg-gray-100 dark:bg-white/10" />
                          <div>
                            <div class="text-sm">
                              <span class="font-semibold text-gray-900 dark:text-white">{rm?.name ?? r.handle}</span>
                              <span class="ml-1 text-xs text-gray-400">· {relativeTime(r.postedAt)}</span>
                            </div>
                            <p class="mt-0.5 text-sm leading-relaxed text-gray-700 dark:text-gray-200">{r.body}</p>
                            <button data-like class="mt-1 inline-flex items-center gap-1 rounded-lg border border-gray-200 px-2 py-0.5 text-xs font-semibold text-gray-600 transition hover:border-brand-400 hover:text-brand-600 dark:border-white/10 dark:text-gray-300">
                              <span>👍</span> <span data-likes>{r.likes}</span>
                            </button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script is:inline define:vars={{ uid }}>
  (function () {
    const root = document.getElementById(uid);
    if (!root) return;
    const article = root.getAttribute("data-article");

    // Likes persist per-visitor in localStorage (toggle on/off).
    const LK = "likes:" + article;
    let liked = {};
    try { liked = JSON.parse(localStorage.getItem(LK) || "{}"); } catch (e) {}
    root.querySelectorAll("[data-like]").forEach((btn, i) => {
      const span = btn.querySelector("[data-likes]");
      const base = +span.textContent;
      const key = "s" + i;
      const apply = () => { span.textContent = base + (liked[key] ? 1 : 0); btn.classList.toggle("border-brand-400", !!liked[key]); btn.classList.toggle("text-brand-600", !!liked[key]); };
      apply();
      btn.addEventListener("click", () => { liked[key] = !liked[key]; localStorage.setItem(LK, JSON.stringify(liked)); apply(); });
    });

    // Visitor comments persist per-visitor in localStorage.
    const CK = "comments:" + article;
    const yours = root.querySelector("[data-yours]");
    const countEl = root.querySelector("[data-count]");
    const seedCount = +countEl.textContent;

    function read() { try { return JSON.parse(localStorage.getItem(CK) || "[]"); } catch (e) { return []; } }
    function esc(s) { return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
    function timeAgo() { return "just now"; }

    function render() {
      const list = read();
      countEl.textContent = seedCount + list.length;
      yours.innerHTML = list.map((c, i) =>
        '<div class="rounded-2xl border border-brand-200 bg-brand-50/40 p-4 dark:border-brand-500/30 dark:bg-brand-900/10">' +
          '<div class="flex items-start gap-3">' +
            '<div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-pink-500 font-bold text-white">' + esc((c.name || "You")[0].toUpperCase()) + '</div>' +
            '<div class="min-w-0 flex-1">' +
              '<div class="flex items-center gap-2 text-sm"><span class="font-semibold text-gray-900 dark:text-white">' + esc(c.name || "You") + '</span><span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-300">you</span><span class="text-xs text-gray-400">· ' + esc(c.when) + '</span></div>' +
              '<p class="mt-1 text-sm leading-relaxed text-gray-700 dark:text-gray-200">' + esc(c.body) + '</p>' +
              '<button data-del="' + i + '" class="mt-2 text-xs font-semibold text-gray-400 hover:text-red-500">Delete</button>' +
            '</div>' +
          '</div>' +
        '</div>'
      ).join("");
      yours.querySelectorAll("[data-del]").forEach((b) => b.addEventListener("click", () => {
        const list = read(); list.splice(+b.getAttribute("data-del"), 1); localStorage.setItem(CK, JSON.stringify(list)); render();
      }));
    }

    root.querySelector("[data-post]").addEventListener("click", () => {
      const body = root.querySelector("[data-body]").value.trim();
      const name = root.querySelector("[data-name]").value.trim();
      if (!body) return;
      const list = read();
      list.unshift({ name, body, when: timeAgo() });
      localStorage.setItem(CK, JSON.stringify(list));
      root.querySelector("[data-body]").value = "";
      render();
    });

    render();
  })();
</script>
