---
import { getCollection } from "astro:content";
import { AI, SITE } from "../consts";
import { categoryName } from "../lib/utils";

// Build a small client-side knowledge index from the articles. The assistant
// embeds these on-device, retrieves the most relevant, and writes a grounded
// answer — all in the browser via Transformers.js (free Hugging Face models).
const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
const docs = posts.map((p) => ({
  id: p.id,
  url: `/blog/${p.id}/`,
  title: p.data.title,
  category: categoryName(p.data.category),
  text: `${p.data.title}. ${p.data.description} Topic: ${categoryName(p.data.category)}. Tags: ${(p.data.tags || []).join(", ")}.`,
}));

const suggestions = [
  "What is attention in transformers?",
  "Why do LLMs hallucinate?",
  "Explain the Monty Hall problem",
  "How does compound interest work?",
];
---

{AI.enabled && (
  <>
    <button
      id="ai-fab"
      aria-label="Open AI assistant"
      class="fixed bottom-6 left-6 z-40 inline-flex items-center gap-2 rounded-full bg-gradient-to-br from-brand-600 to-pink-500 px-4 py-3 font-semibold text-white shadow-lg shadow-brand-600/30 transition hover:scale-105"
    >
      <span class="text-lg">✨</span><span class="hidden sm:inline">Ask Poly</span>
    </button>

    <div
      id="ai-panel"
      class="fixed bottom-24 left-4 right-4 z-50 hidden max-h-[70vh] w-auto flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl sm:left-6 sm:right-auto sm:w-[400px] dark:border-white/10 dark:bg-ink"
      data-cdn={AI.cdn}
      data-embed={AI.embedModel}
      data-gen={AI.genModel}
      data-docs={JSON.stringify(docs)}
    >
      <div class="flex items-center justify-between border-b border-gray-200 bg-gradient-to-r from-brand-600 to-pink-500 px-4 py-3 text-white dark:border-white/10">
        <div class="flex items-center gap-2">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-white/20 text-lg">🦉</span>
          <div>
            <p class="text-sm font-bold leading-none">Ask Poly</p>
            <p class="text-[11px] opacity-80">AI assistant · runs in your browser</p>
          </div>
        </div>
        <button id="ai-close" aria-label="Close" class="rounded-lg p-1 text-white/80 hover:bg-white/20 hover:text-white">✕</button>
      </div>

      <div id="ai-messages" class="flex-1 space-y-3 overflow-y-auto p-4 text-sm">
        <div class="rounded-2xl rounded-tl-sm bg-gray-100 p-3 text-gray-700 dark:bg-white/5 dark:text-gray-200">
          Hi! I'm <b>Poly</b> 🦉 — a free AI assistant running entirely on your device (no servers, no cost). Ask me about anything on this site and I'll find the best article and explain it.
          <span class="mt-1 block text-xs text-gray-400">First question downloads a small model once (~100MB), then it's instant & offline.</span>
        </div>
      </div>

      <div id="ai-suggest" class="flex flex-wrap gap-2 px-4 pb-2">
        {suggestions.map((s) => (
          <button class="ai-chip rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-600 transition hover:border-brand-400 hover:text-brand-600 dark:border-white/10 dark:text-gray-300">{s}</button>
        ))}
      </div>

      <div class="border-t border-gray-200 p-3 dark:border-white/10">
        <div class="flex items-end gap-2">
          <textarea id="ai-input" rows="1" placeholder="Ask anything…" class="max-h-24 flex-1 resize-none rounded-xl border border-gray-300 bg-transparent px-3 py-2 text-sm outline-none focus:border-brand-500 dark:border-white/15"></textarea>
          <button id="ai-send" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-600 text-white transition hover:bg-brand-700 disabled:opacity-50" aria-label="Send">➤</button>
        </div>
        <p class="mt-1.5 text-center text-[10px] text-gray-400">Powered by Transformers.js + Hugging Face · answers are AI-generated, verify what matters</p>
      </div>
    </div>

    <script is:inline define:vars={{ siteName: SITE.name }}>
      (function () {
        const fab = document.getElementById("ai-fab");
        const panel = document.getElementById("ai-panel");
        const closeBtn = document.getElementById("ai-close");
        const msgs = document.getElementById("ai-messages");
        const input = document.getElementById("ai-input");
        const send = document.getElementById("ai-send");
        if (!fab || !panel) return;

        const CDN = panel.getAttribute("data-cdn");
        const EMBED = panel.getAttribute("data-embed");
        const GEN = panel.getAttribute("data-gen");
        const DOCS = JSON.parse(panel.getAttribute("data-docs") || "[]");

        let extractor = null, generator = null, docVecs = null, loading = false, ready = false;

        function open() { panel.classList.remove("hidden"); panel.classList.add("flex"); input.focus(); }
        function close() { panel.classList.add("hidden"); panel.classList.remove("flex"); }
        fab.addEventListener("click", () => (panel.classList.contains("hidden") ? open() : close()));
        closeBtn.addEventListener("click", close);

        function bubble(role, html) {
          const el = document.createElement("div");
          el.className = role === "user"
            ? "ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-brand-600 p-3 text-white"
            : "max-w-[92%] rounded-2xl rounded-tl-sm bg-gray-100 p-3 text-gray-700 dark:bg-white/5 dark:text-gray-200";
          el.innerHTML = html;
          msgs.appendChild(el);
          msgs.scrollTop = msgs.scrollHeight;
          return el;
        }
        function esc(s) { return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }

        async function ensureModels(statusEl) {
          if (ready) return true;
          if (loading) return false;
          loading = true;
          try {
            const tf = await import(CDN);
            const setPct = (label) => (p) => { if (p && p.status === "progress" && statusEl) statusEl.innerHTML = "⏳ " + label + " " + Math.round(p.progress || 0) + "%"; };
            statusEl.innerHTML = "⏳ Loading search model…";
            extractor = await tf.pipeline("feature-extraction", EMBED, { progress_callback: setPct("search model") });
            statusEl.innerHTML = "⏳ Indexing articles…";
            const out = await extractor(DOCS.map((d) => d.text), { pooling: "mean", normalize: true });
            docVecs = out.tolist();
            statusEl.innerHTML = "⏳ Loading writer model (one-time)…";
            try {
              generator = await tf.pipeline("text2text-generation", GEN, { progress_callback: setPct("writer model") });
            } catch (e) { generator = null; } // retrieval-only fallback
            ready = true;
            loading = false;
            return true;
          } catch (e) {
            loading = false;
            statusEl.innerHTML = "⚠️ Couldn't load the AI model (check your connection). I can still point you to articles by keyword.";
            return false;
          }
        }

        function dot(a, b) { let s = 0; for (let i = 0; i < a.length; i++) s += a[i] * b[i]; return s; }

        function keywordTop(q) {
          const words = q.toLowerCase().split(/\W+/).filter((w) => w.length > 3);
          return DOCS.map((d) => ({ d, score: words.reduce((n, w) => n + (d.text.toLowerCase().includes(w) ? 1 : 0), 0) }))
            .sort((a, b) => b.score - a.score).slice(0, 3).filter((x) => x.score > 0).map((x) => x.d);
        }

        async function answer(q) {
          bubble("user", esc(q));
          const thinking = bubble("assistant", "…");
          const ok = await ensureModels(thinking);

          let top = [];
          if (ok && extractor && docVecs) {
            const qv = (await extractor([q], { pooling: "mean", normalize: true })).tolist()[0];
            top = DOCS.map((d, i) => ({ d, score: dot(qv, docVecs[i]) })).sort((a, b) => b.score - a.score).slice(0, 3).map((x) => x.d);
          } else {
            top = keywordTop(q);
          }

          const sources = top.length
            ? '<div class="mt-2 border-t border-gray-200 pt-2 dark:border-white/10"><p class="mb-1 text-xs font-semibold text-gray-400">📚 Related reading</p>' +
              top.map((d) => '<a href="' + d.url + '" class="block text-xs font-medium text-brand-600 hover:underline dark:text-brand-300">→ ' + esc(d.title) + '</a>').join("") + '</div>'
            : "";

          if (ok && generator && top.length) {
            try {
              const ctx = top.map((d) => d.title + ": " + d.text).join("\n");
              const prompt = "You are Poly, a friendly assistant for the " + siteName + " learning site. Using the context, answer the question clearly in 2-4 sentences. If the context is unrelated, say you're not sure and suggest the closest topic.\n\nContext:\n" + ctx + "\n\nQuestion: " + q + "\nAnswer:";
              const out = await generator(prompt, { max_new_tokens: 200, temperature: 0.3, repetition_penalty: 1.3 });
              const text = (out[0].generated_text || "").trim() || "Here's what I found that's most relevant:";
              thinking.innerHTML = esc(text) + sources;
            } catch (e) {
              thinking.innerHTML = (top.length ? "Here are the most relevant articles I found:" : "I'm not sure about that one yet.") + sources;
            }
          } else {
            thinking.innerHTML = (top.length ? "Here are the most relevant articles I found:" : "I couldn't match that to an article — try rephrasing, or browse the Topics page.") + sources;
          }
          msgs.scrollTop = msgs.scrollHeight;
        }

        function submit() {
          const q = input.value.trim();
          if (!q || loading) return;
          input.value = "";
          input.style.height = "auto";
          answer(q);
        }
        send.addEventListener("click", submit);
        input.addEventListener("keydown", (e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); submit(); } });
        input.addEventListener("input", () => { input.style.height = "auto"; input.style.height = Math.min(96, input.scrollHeight) + "px"; });
        document.querySelectorAll("#ai-suggest .ai-chip").forEach((c) => c.addEventListener("click", () => { input.value = c.textContent; submit(); }));
      })();
    </script>
  </>
)}
