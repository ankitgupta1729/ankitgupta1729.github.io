---
import type { Project } from "../consts";

interface Props {
  project: Project;
  /** Compact = homepage teaser (no highlights list). */
  compact?: boolean;
}

const { project: p, compact = false } = Astro.props;

const STATUS = {
  live: { label: "Live", cls: "status-live" },
  sleeping: { label: "Sleeping · wakes on open", cls: "status-sleeping" },
  building: { label: "Starting up", cls: "status-building" },
  paused: { label: "Paused", cls: "status-sleeping" },
  error: { label: "Temporarily down", cls: "status-error" },
} as const;
const s = STATUS[p.status];
const platformIcon = p.platform === "GitHub Pages" ? "github" : "hf";
const launchLabel = p.self ? "You are here" : "Launch app";
---

<article
  data-kind={p.kind}
  data-project={p.slug}
  class="project-card group relative flex flex-col overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-transparent hover:shadow-xl dark:border-white/10 dark:bg-white/[0.03]"
  style={`--g1:${p.gradient[0]};--g2:${p.gradient[1]}`}
>
  <!-- Gradient header -->
  <div class="project-band relative flex h-28 items-end justify-between px-5 pb-4">
    <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white/95 text-3xl shadow-lg ring-1 ring-black/5 transition duration-300 group-hover:scale-110 group-hover:-rotate-3 dark:bg-ink/90" aria-hidden="true">
      {p.icon}
    </span>
    <span
      class:list={["status-pill", s.cls]}
      data-hf-space={p.hfSpace}
      role="status"
      aria-live="polite"
    >
      <span class="status-dot" aria-hidden="true"></span>
      <span class="status-text">{s.label}</span>
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5 pt-4">
    <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
      <span class="inline-flex items-center gap-1">
        {platformIcon === "github" ? (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
        ) : (
          <span aria-hidden="true">🤗</span>
        )}
        {p.platform}
      </span>
      <span aria-hidden="true">·</span>
      <span>{p.kind === "ai" ? "AI app" : "Web app"}</span>
    </div>

    <h3 class="mt-2 font-serif text-xl font-bold leading-snug text-gray-900 dark:text-white">{p.name}</h3>
    <p class="mt-1 text-sm font-medium text-brand-700 dark:text-brand-300">{p.tagline}</p>
    <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{p.description}</p>

    {
      !compact && (
        <ul class="mt-4 space-y-1.5 text-sm text-gray-700 dark:text-gray-300">
          {p.highlights.map((h) => (
            <li class="flex items-start gap-2">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" style="background:var(--g1)" aria-hidden="true" />
              {h}
            </li>
          ))}
        </ul>
      )
    }

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Built with">
      {p.tech.map((t) => (
        <li class="rounded-md bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-white/[0.06] dark:text-gray-300">{t}</li>
      ))}
    </ul>

    {
      p.note && (
        <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900 dark:border-amber-500/30 dark:bg-amber-900/20 dark:text-amber-200">
          💡 {p.note}
        </p>
      )
    }
    {
      p.status === "error" && (
        <p class="error-note mt-4 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-900 dark:border-rose-500/30 dark:bg-rose-900/20 dark:text-rose-200">
          This Space is currently failing to start. Its page shows the build logs while it is being fixed.
        </p>
      )
    }

    <div class="mt-auto pt-5">
      <div class="flex flex-wrap gap-2">
        {
          p.self ? (
            <span class="inline-flex items-center gap-1.5 rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-500 dark:bg-white/5 dark:text-gray-400">
              📍 {launchLabel}
            </span>
          ) : (
            <a
              href={p.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="launch-btn inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-sm font-semibold text-white shadow-md transition hover:brightness-110 hover:shadow-lg"
              aria-label={`${launchLabel}: ${p.name} (opens in a new tab)`}
            >
              {launchLabel}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          )
        }
        {
          p.spaceUrl && (
            <a
              href={p.spaceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 px-3.5 py-2 text-sm font-semibold text-gray-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-white/15 dark:text-gray-200 dark:hover:text-white"
              aria-label={`Hugging Face Space page for ${p.name} (opens in a new tab)`}
            >
              🤗 Space
            </a>
          )
        }
        {
          p.repoUrl && (
            <a
              href={p.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-gray-300 px-3.5 py-2 text-sm font-semibold text-gray-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-white/15 dark:text-gray-200 dark:hover:text-white"
              aria-label={`${p.repoLabel ?? "Source code"} for ${p.name} on GitHub (opens in a new tab)`}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
              {p.repoLabel ?? "Source"}
            </a>
          )
        }
      </div>
      {
        p.sourceNote && (
          <p class="mt-3 flex items-start gap-1.5 text-xs text-gray-500 dark:text-gray-400">
            <span aria-hidden="true">🔒</span>
            {p.sourceNote}
          </p>
        )
      }
    </div>
  </div>
</article>
