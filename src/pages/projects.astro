---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { PROJECTS, PROFILES, SITE } from "../consts";

const apps = PROJECTS.filter((p) => !p.self);
const platforms = new Set(PROJECTS.map((p) => p.platform)).size;

// Every public code location, one row per project.
const repos = PROJECTS.flatMap((p) => {
  const rows: { project: string; icon: string; label: string; href: string; kind: string }[] = [];
  if (p.repoUrl)
    rows.push({ project: p.name, icon: p.icon, label: p.repoUrl.replace("https://", ""), href: p.repoUrl, kind: p.repoLabel ?? "Source code" });
  if (p.spaceUrl)
    rows.push({ project: p.name, icon: p.icon, label: p.spaceUrl.replace("https://", ""), href: p.spaceUrl, kind: "Space repository" });
  return rows;
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Live apps & projects by ${SITE.author}`,
  itemListElement: PROJECTS.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareApplication",
      name: p.name,
      description: p.description,
      url: p.liveUrl,
      applicationCategory: p.kind === "ai" ? "AI application" : "Web application",
      operatingSystem: "Web browser",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: { "@type": "Person", name: SITE.author, url: "https://github.com/ankitgupta1729" },
      ...(p.repoUrl ? { codeRepository: p.repoUrl } : {}),
    },
  })),
};
---

<BaseLayout
  title="Projects & live apps"
  description={`Live web and AI applications by ${SITE.author} — physician-influence analytics, an AI GATE tutor, income-tax systems and MCP tools — with links to every app and its source.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="aurora relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/70 px-4 py-1.5 text-sm font-medium text-brand-700 backdrop-blur dark:border-brand-500/30 dark:bg-white/5 dark:text-brand-300">
        🚀 Portfolio · free to use · no sign-up
      </span>
      <h1 class="mt-5 max-w-3xl font-serif text-4xl font-bold leading-tight tracking-tight text-gray-900 sm:text-6xl dark:text-white">
        Projects &amp; <span class="text-gradient">live apps</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600 dark:text-gray-300">
        Everything I've built and deployed, in one place. Every app runs in your browser — open it, try it, and
        browse the source where it's public.
      </p>
      <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4">
        <div class="rounded-2xl border border-gray-200 bg-white/70 p-4 text-center backdrop-blur dark:border-white/10 dark:bg-white/5">
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Apps</dt>
          <dd class="mt-1 font-serif text-3xl font-bold text-gray-900 dark:text-white">{apps.length}</dd>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white/70 p-4 text-center backdrop-blur dark:border-white/10 dark:bg-white/5">
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">AI apps</dt>
          <dd class="mt-1 font-serif text-3xl font-bold text-gray-900 dark:text-white">{apps.filter((p) => p.kind === "ai").length}</dd>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white/70 p-4 text-center backdrop-blur dark:border-white/10 dark:bg-white/5">
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Platforms</dt>
          <dd class="mt-1 font-serif text-3xl font-bold text-gray-900 dark:text-white">{platforms}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Apps -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-labelledby="apps-heading">
    <h2 id="apps-heading" class="mb-2 font-serif text-3xl font-bold text-gray-900 dark:text-white">Applications</h2>
    <p class="mb-6 text-gray-600 dark:text-gray-400">
      Status badges for Hugging Face apps are checked live. A sleeping Space wakes up when you open it, which takes up to a minute.
    </p>
    <ProjectGrid projects={PROJECTS} filters id="all-projects" />
  </section>

  <!-- Profiles -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6" aria-labelledby="profiles-heading">
    <h2 id="profiles-heading" class="mb-6 font-serif text-3xl font-bold text-gray-900 dark:text-white">Find me on</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        PROFILES.map((pr) => (
          <a
            href={pr.href}
            target="_blank"
            rel="noopener noreferrer"
            class="card-lift group flex items-center gap-5 rounded-3xl border border-gray-200 bg-white p-6 hover:border-brand-300 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-brand-500/50"
          >
            <span class:list={[
              "grid h-16 w-16 shrink-0 place-items-center rounded-2xl text-3xl",
              pr.name === "GitHub" ? "bg-gray-900 text-white dark:bg-white dark:text-gray-900" : "bg-amber-100 dark:bg-amber-400/15",
            ]} aria-hidden="true">
              {pr.name === "GitHub" ? (
                <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.6 18 4.9 18 4.9c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
              ) : "🤗"}
            </span>
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{pr.name}</p>
              <p class="truncate text-lg font-bold text-gray-900 dark:text-white">{pr.handle}</p>
              <p class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">{pr.blurb}</p>
            </div>
            <span class="ml-auto hidden shrink-0 font-semibold text-brand-600 transition group-hover:translate-x-0.5 sm:block dark:text-brand-300">{pr.cta} ↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Repositories -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-labelledby="repos-heading">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 id="repos-heading" class="font-serif text-3xl font-bold text-gray-900 dark:text-white">Repositories</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-400">Where the code for each app lives.</p>
      </div>
      <a href="https://github.com/ankitgupta1729?tab=repositories" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-brand-600 hover:underline dark:text-brand-300">All repositories ↗</a>
    </div>
    <div class="overflow-hidden rounded-2xl border border-gray-200 dark:border-white/10">
      <ul class="divide-y divide-gray-200 dark:divide-white/10">
        {
          repos.map((r) => (
            <li>
              <a
                href={r.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col gap-1 bg-white px-5 py-4 transition hover:bg-brand-50/60 sm:flex-row sm:items-center sm:gap-4 dark:bg-white/[0.02] dark:hover:bg-white/5"
              >
                <span class="flex items-center gap-3 font-semibold text-gray-900 sm:w-72 sm:shrink-0 dark:text-white">
                  <span aria-hidden="true">{r.icon}</span>{r.project}
                </span>
                <span class="min-w-0 flex-1 truncate font-mono text-sm text-brand-700 dark:text-brand-300">{r.label}</span>
                <span class="shrink-0 rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-white/10 dark:text-gray-300">{r.kind}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-4 flex items-start gap-2 text-sm text-gray-500 dark:text-gray-400">
      <span aria-hidden="true">🔒</span>
      Madrigal Influence Intelligence is client work: its source stays private, and its public repository holds only the
      compiled demo built from synthetic data.
    </p>
  </section>
</BaseLayout>
