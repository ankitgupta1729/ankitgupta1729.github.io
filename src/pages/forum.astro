---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GISCUS, SOCIAL } from "../consts";

const configured = GISCUS.repoId && GISCUS.categoryId;
const discussionsUrl = `${SOCIAL.github === "" ? "" : "https://github.com"}/${GISCUS.repo}/discussions`;

const rooms = [
  { icon: "🤖", name: "AI & ML", desc: "Models, papers, agents, and where the field is heading." },
  { icon: "∑", name: "Math & Proofs", desc: "Puzzles, proofs, and elegant problem-solving." },
  { icon: "💹", name: "Finance & Markets", desc: "Quant ideas, economics, and personal finance." },
  { icon: "🔬", name: "Science & Physics", desc: "From quantum weirdness to biology breakthroughs." },
  { icon: "🏛️", name: "History & Society", desc: "Lessons from the past; debates about the present." },
  { icon: "💡", name: "Show & Tell", desc: "Share projects, ask for feedback, find collaborators." },
];
---

<BaseLayout title="Forum" description="Discuss ideas across every topic with the Polymath community.">
  <section class="aurora">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
      <h1 class="font-serif text-4xl font-bold text-gray-900 sm:text-5xl dark:text-white">The Forum</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
        A calm corner of the internet to ask questions, share what you're learning, and respectfully argue about ideas.
        Powered by GitHub Discussions — your account, your data, zero ads.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={discussionsUrl} target="_blank" rel="noopener" class="rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-700">Open full forum on GitHub →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 class="mb-6 font-serif text-2xl font-bold text-gray-900 dark:text-white">Discussion rooms</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        rooms.map((r) => (
          <a href={discussionsUrl} target="_blank" rel="noopener" data-reveal class="card-lift rounded-2xl border border-gray-200 bg-white p-6 hover:border-brand-300 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-brand-500/50">
            <div class="text-3xl">{r.icon}</div>
            <h3 class="mt-3 text-lg font-bold text-gray-900 dark:text-white">{r.name}</h3>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{r.desc}</p>
          </a>
        ))
      }
    </div>

    <div class="mt-12">
      <h2 class="mb-4 font-serif text-2xl font-bold text-gray-900 dark:text-white">Community wall</h2>
      <p class="mb-5 text-gray-600 dark:text-gray-400">Drop a message below — say hi, share an idea, or start a debate.</p>

      {
        configured ? (
          <div class="giscus rounded-2xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-white/[0.02]" />
        ) : (
          <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center dark:border-white/10 dark:bg-white/[0.02]">
            <p class="text-lg font-semibold text-gray-800 dark:text-gray-200">The community wall switches on after Giscus setup</p>
            <p class="mx-auto mt-2 max-w-md text-sm text-gray-600 dark:text-gray-400">
              One-time step: authorize the Giscus GitHub App and paste your IDs into <code>src/consts.ts</code>.
              Until then, use the GitHub Discussions link above.
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    configured && (
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-mapping="specific"
        data-term="Community wall"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async
      />
    )
  }
</BaseLayout>
